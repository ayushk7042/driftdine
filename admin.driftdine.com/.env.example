# TheTrendSnap API — copy to .env and fill in. Never commit the filled copy.
NODE_ENV=development
PORT=9000

# MongoDB connection string
MONGO_URI=

# Auth
JWT_SECRET=
JWT_EXPIRE=7d

# Cloudinary (media uploads)
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Outbound mail (contact replies)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# Content automation
AI_PROVIDER=gemini
GEMINI_API_KEY=
GNEWS_API_KEY=
NEWS_API_KEY=

AUTO_SEO_ENABLED=true
CRON_TIME=0 2 * * *
